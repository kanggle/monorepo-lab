{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "**": false,
      "main": false,
      "preview/*": true
    }
  },
  "framework": "nextjs",
  "installCommand": "pnpm install --no-frozen-lockfile",
  "ignoreCommand": "bash \"$(git rev-parse --show-toplevel)/infra/demo/auth-forwarder/vercel-ignore.sh\""
}
