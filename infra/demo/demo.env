# =============================================================================
# infra/demo/demo.env — 통합 데모 전용 cross-project 환경변수 (TASK-MONO-344)
# =============================================================================
# demo-up.sh 가 이 파일을 source 한 뒤 각 프로젝트 compose 를 기동한다.
# 프로젝트 compose 파일은 byte-unchanged 로 두고, 데모 토폴로지에 필요한 값만
# 여기서 주입한다.
#
# 토폴로지: 각 프로젝트가 자기 compose 프로젝트(-p <slug>)로 뜨고, 공유 external
# `traefik-net` 위에서 서로의 container_name 으로 DNS 해소한다.
# =============================================================================

# =============================================================================
# --- DEMO_DOMAIN — 데모가 어느 호스트명으로 서빙되는가 (TASK-MONO-358)
# =============================================================================
# Traefik 라우터는 `Host(`console.${DEMO_DOMAIN:-local}`)` 형태다.
#
#   로컬:  DEMO_DOMAIN=local          → console.local  (hosts 파일 → 127.0.0.1)
#   EC2 :  DEMO_DOMAIN=<ip>.sslip.io  → console.3-36-44-101.sslip.io
#
# sslip.io 는 `<anything>.1-2-3-4.sslip.io` → 1.2.3.4 로 해석되는 공개 와일드카드
# DNS 다. 도메인 구매도 DNS 레코드 설정도 필요 없다. 인스턴스에 EIP 가 없어 start
# 마다 공인 IP 가 바뀌므로, 클라우드에서는 **부팅 시 IMDS 로 읽어 주입**한다.
#
# 여기 기본값이 `local` 이므로 개발자 로컬 렌더는 변경 전과 바이트 동일하다.
#
# ⚠ `DEMO_DOMAIN=local` 이 아니라 `${DEMO_DOMAIN:-local}` 이어야 한다. demo-up.sh 는
#   `set -a; source demo.env; set +a` 로 이 파일을 읽으므로, 무조건 대입이면 호출자가
#   미리 export 한 값을 **덮어써 버린다** — 클라우드에서 영원히 `local` 로 떠서
#   Traefik 이 아무 요청에도 매치되지 않는다. 이 파일의 다른 값들과 성질이 다른 유일한
#   변수다(나머지는 데모가 소유하고, 이것만 호출 환경이 소유한다).
DEMO_DOMAIN="${DEMO_DOMAIN:-local}"

# --- redis -------------------------------------------------------------------
# wms/iam 앱은 REDIS_PASSWORD env 를 읽지 않는다. base compose 의 redis 가
# ${REDIS_PASSWORD} 로 requirepass 를 걸므로, 데모에서는 비워 둔다. (MONO-342)
REDIS_PASSWORD=

# =============================================================================
# --- 도메인 간 신원(OIDC) — issuer 와 jwks 를 **분리**한다 (TASK-MONO-358)
# =============================================================================
# 이것이 이 파일에서 가장 미묘한 부분이다. 두 URL 은 성질이 다르다:
#
#   issuer      = 토큰의 `iss` 클레임과 **문자열 비교**된다. 동시에 브라우저가
#                 OIDC 인가 엔드포인트로 리다이렉트되어 **실제로 도달해야** 하는
#                 주소이기도 하다  → 공개 호스트명이어야 한다.
#   jwk-set-uri = 리소스 서버가 **실제로 fetch** 한다 → 컨테이너 DNS 가 맞다.
#
# 뒤집으면 둘 다 깨진다:
#   · jwks 를 공개 호스트명으로 두면 — AWS 는 인스턴스가 **자기 공인 IP** 로 보내는
#     트래픽을 되돌려주지 않는다(IGW hairpin 부재) → JWKS fetch 가 죽는다.
#   · issuer 를 컨테이너 DNS 로 두면 — 브라우저가 인가 엔드포인트에 도달할 수 없다.
#     (이것이 MONO-358 이전의 상태였다: iam 은 `iss=http://auth-service:8081` 을
#      발급하고 있었고, 콘솔은 `http://iam.local` 을 기대했으며, 그 호스트를 서빙하는
#      **라우터는 존재하지도 않았다.** 96 컨테이너가 healthy 로 떠도 로그인은 불가능.)
#
# `iam.${DEMO_DOMAIN}` 이 컨테이너 안에서도 해소되는 이유는 Traefik 컨테이너에 건
# network alias 다 (infra/traefik/docker-compose.yml).
IAM_PUBLIC_URL=http://iam.${DEMO_DOMAIN}
IAM_JWKS_URL=http://iam-auth-service:8081/oauth2/jwks

# scm / fan / finance / erp 는 **제네릭 이름**을 읽는다(각 compose 의
# `${OIDC_ISSUER_URL:-...}` / `${JWT_JWKS_URI:-...}`). iam 이 실제로 발급하는 iss 와
# 반드시 같아야 한다 — 그래서 iam 쪽도 같은 값으로 맞춘다
# (infra/demo/iam-traefik.override.yml).
OIDC_ISSUER_URL=${IAM_PUBLIC_URL}
JWT_JWKS_URI=${IAM_JWKS_URL}

# --- wms → iam OIDC ----------------------------------------------------------
# wms 는 자기 접두사(WMS_*)를 쓴다.
WMS_OIDC_ISSUER_URL=${IAM_PUBLIC_URL}
WMS_OIDC_JWK_SET_URI=${IAM_JWKS_URL}
WMS_OIDC_ALLOWED_ISSUERS=${IAM_PUBLIC_URL}
WMS_CORS_ALLOWED_ORIGINS=http://console.${DEMO_DOMAIN}

# --- platform-console ---------------------------------------------------------
# console-web 은 OIDC 코드 교환을 **서버사이드**로 한다 → `${OIDC_ISSUER_URL}` 이
# 컨테이너 안에서도 해소돼야 한다(Traefik alias 가 그 일을 한다).
# 리다이렉트 URI 는 **브라우저가 되돌아오는 곳**이므로 반드시 공개 호스트명이다.
OIDC_REDIRECT_URI=http://console.${DEMO_DOMAIN}/api/auth/callback
CONSOLE_REGISTRY_URL=${IAM_PUBLIC_URL}/api/admin/console/registry
CONSOLE_TOKEN_EXCHANGE_URL=${IAM_PUBLIC_URL}/api/admin/auth/token-exchange
CONSOLE_BFF_IAM_ISSUER_URL=${IAM_PUBLIC_URL}

# 🔴 콜드스타트에서 **첫 로그인이 실패한다** — 이 두 줄이 없으면 (TASK-MONO-532)
#
# console-web 의 기본 타임아웃은 5000ms 다(`shared/config/env.ts`, compose 가
# `${TOKEN_EXCHANGE_TIMEOUT_MS:-5000}` 로 전달). 콜드 IAM 은 Spring Boot 첫 요청이라
# 그 5초를 넘긴다. 결과는 조용한 지연이 아니라 **로그인 실패**다:
#
#   http://console.local/login?error=operator_exchange_unavailable
#   console-web 로그: operator_exchange_timeout {timeoutMs:5000}
#                     operator_exchange_unavailable_on_callback
#
# 🔴 **웜 2회차는 성공한다.** 그래서 이 결함은 "스택을 띄우고 조금 있다가" 재면 절대
# 재현되지 않는다 — 판정은 반드시 콜드 1회차로 한다.
#
# 🔴 증상이 면접관에게 "데모가 고장났다" 로 읽힌다. 화면은 재시도하라고 말하지 않는다.
#
# 값 30000 의 근거: federation-hardening-e2e 스택이 **같은 노브에 이미 쓰는 값**이다
# (콘솔 콜드스타트 캐스케이드 대응으로 한 번 겪은 문제 — 통합 데모만 그 학습을 못 받고
# 있었다). 트레이드오프를 알고 고른다: **IAM 이 진짜로 죽어 있으면 5초가 아니라 30초를
# 매달린다.** 데모에서는 거짓 에러 페이지보다 낫다는 판단이고, 프로덕션 값이 아니다.
# 더 키우지 말 것 — 그 방향은 장애를 "느린 성공"처럼 보이게 만든다.
TOKEN_EXCHANGE_TIMEOUT_MS=30000
REGISTRY_TIMEOUT_MS=30000

# 로그인 성공 후 브라우저를 되돌려 보낼 오리진. `NEXT_PUBLIC_APP_URL` 로는 못 한다 —
# Next 가 `process.env.NEXT_PUBLIC_*` 를 **빌드타임에 인라인**하므로 프리베이크된
# AMI 이미지는 빌드가 알던 호스트(`console.local`)에 영구히 고정된다. 데모 도메인은
# 부팅 때 IP 에서 파생되므로, 이게 없으면 로그인 직후 콜백이 브라우저를 해소 불가능한
# `http://console.local/...` 로 보낸다(EC2 실측).
CONSOLE_PUBLIC_ORIGIN=http://console.${DEMO_DOMAIN}

# 데모는 평문 HTTP 다(TLS 없음). 브라우저는 **localhost 가 아닌 오리진에서 http 로 온
# `Secure` 쿠키를 저장조차 하지 않는다** → PKCE/state 쿠키가 사라지고 콜백이
# `invalid_state` 로 튕긴다. curl 로 재현했다: Set-Cookie 를 받고도 쿠키 자가 비어 있다.
# (그래서 지금껏 동작한 콘솔 로그인 경로는 `localhost:3000` 뿐이었다 — `console.local`
#  도 같은 이유로 실패한다.)
#
# TLS 로 풀 수 없는가: sslip.io 는 Public Suffix List 에 **없다** → Let's Encrypt 가
# `sslip.io` 전체를 하나의 등록 도메인으로 묶어 주당 50장 한도를 전 세계와 공유한다.
# 실 도메인을 사지 않는 한 ACME 발급은 성립하지 않는다.
#
# 값은 정확히 "false" 여야 꺼진다(오타·빈값·미설정 → Secure 유지). 가드 (m) 이
# `https://` 오리진과의 조합을 막는다 — 그것만이 진짜 다운그레이드다.
CONSOLE_COOKIE_SECURE=false

# =============================================================================
# --- 콘솔 per-domain federation (TASK-MONO-505)
# =============================================================================
# 이 블록이 없으면 콘솔은 자기 코드 기본값으로 떨어지는데, **그 기본값이 전부
# 하드코딩된 `.local` 호스트명**이다(`console-web/src/shared/config/env.ts` 의 zod
# `.default(...)` 13개, `console-bff/application.yml` 의 `${KEY:http://x.local}` 7개).
#
#   로컬:  `.local` 이 hosts 파일 + Traefik alias 로 해소된다 → **우연히 동작한다**
#   AWS :  도메인이 `<ip>.sslip.io` 다 → `wms.local` 은 아무데도 해소되지 않는다
#
# 결과가 이 저장소가 반복해서 당한 그 모양이다 — 컨테이너 전부 healthy, 콘솔도 뜨고,
# 도메인 운영 섹션 다섯 개만 죽는다. **로컬에서는 초록이라 잡히지도 않는다.**
# 가드 (u) 가 "`.local` 기본값을 가진 콘솔 키는 여기서 반드시 덮인다" 를 강제한다.
#
# 왜 컨테이너 DNS 가 아니라 호스트명인가
# -----------------------------------------------------------------------------
# 통합 데모에서 traefik-net 에 합류하는 것은 **각 프로젝트의 gateway-service 뿐**이고
# 백엔드 서비스는 자기 프로젝트 네트워크에 남는다. 그래서 콘솔은 `wms-admin-service`
# 같은 이름을 **부를 수 없다** — 단일 compose 인 `tests/federation-hardening-e2e`
# 하네스가 쓰는 방식은 여기서 성립하지 않는다(그 오버레이 값을 그대로 옮기면 전부
# NXDOMAIN 이다. "이미 배선돼 있으니 승격만 하면 된다" 는 가정이 여기서 깨진다).
# `<domain>.${DEMO_DOMAIN}` 은 그 프로젝트의 게이트웨이로 들어가므로
# api-gateway-policy 와도 맞는다.
#
# AWS 에서 공인 IP 로 나가지 않는가 — 나가지 않는다. Traefik 컨테이너가 이 이름들의
# network alias 를 들고 있어(가드 (i)) Docker 임베디드 DNS 가 내부에서 답한다.
# 경로(`/api/v1/admin` 등)는 코드 기본값과 **동일하게** 둔다 — 바꾸는 건 호스트뿐이다.
IAM_ADMIN_API_BASE=${IAM_PUBLIC_URL}
CONSOLE_ONBOARDING_URL=${IAM_PUBLIC_URL}/api/admin/onboarding/organizations
WMS_ADMIN_BASE_URL=http://wms.${DEMO_DOMAIN}/api/v1/admin
WMS_OUTBOUND_BASE_URL=http://wms.${DEMO_DOMAIN}/api/v1/outbound
SCM_GATEWAY_BASE_URL=http://scm.${DEMO_DOMAIN}
FINANCE_BASE_URL=http://finance.${DEMO_DOMAIN}
LEDGER_BASE_URL=http://finance.${DEMO_DOMAIN}
ERP_BASE_URL=http://erp.${DEMO_DOMAIN}
ECOMMERCE_ADMIN_BASE_URL=http://ecommerce.${DEMO_DOMAIN}/api/admin
ECOMMERCE_PUBLIC_BASE_URL=http://ecommerce.${DEMO_DOMAIN}/api

# console-bff 아웃바운드 레그. issuer=문자열 비교(공개 호스트명) / JWKS=실제 fetch
# (컨테이너 DNS) 라는 위쪽 원칙이 여기에도 그대로 적용된다.
CONSOLE_BFF_JWK_SET_URI=${IAM_JWKS_URL}
CONSOLE_BFF_OUTBOUND_IAM_BASE_URL=${IAM_PUBLIC_URL}
CONSOLE_BFF_OUTBOUND_WMS_BASE_URL=http://wms.${DEMO_DOMAIN}
CONSOLE_BFF_OUTBOUND_SCM_BASE_URL=http://scm.${DEMO_DOMAIN}
CONSOLE_BFF_OUTBOUND_FINANCE_BASE_URL=http://finance.${DEMO_DOMAIN}
CONSOLE_BFF_OUTBOUND_ERP_BASE_URL=http://erp.${DEMO_DOMAIN}
# 🔴 fed-e2e 오버레이에는 이 레그가 **없다** — ecommerce 가 그 하네스에 아예 없기
# 때문이다(렌더한 서비스 목록에 ecommerce 서비스 0개). 승격할 선례가 없어 신규 작성한다.
CONSOLE_BFF_OUTBOUND_ECOMMERCE_BASE_URL=http://ecommerce.${DEMO_DOMAIN}

# --- wms outbound 외부 스텁 (ADR-MONO-005 category D) -------------------------
WMS_TMS_BASE_URL=http://localhost:9999
WMS_TMS_API_KEY=demo

# --- wms notification Slack 스텁 (CB 로 degrade) -------------------------------
WMS_SLACK_ALERTS_URL=http://localhost:9999/alerts
WMS_SLACK_SHIPPING_URL=http://localhost:9999/shipping

# --- ecommerce (MONO-346) ----------------------------------------------------
# ecommerce compose 는 기본값 없는 bare ${VAR} 를 14개 참조한다. 그 값의 출처인
# projects/ecommerce-microservices-platform/.env 는 gitignored 이므로 갓 clone 한
# 트리(데모 AMI, CI 러너)에서는 전부 빈 문자열로 보간된다.
#
# 그 중 9개가 POSTGRES_PASSWORD 다. postgres:16-alpine 은 빈 superuser 비밀번호로
# 초기화를 거부하므로("Database is uninitialized and superuser password is not
# specified"), ecommerce DB 9개가 기동 실패하고 그 위의 앱 12개가 전부 죽는다.
# compose 는 미설정 변수를 error 가 아닌 **warning** 으로 처리하기 때문에 렌더
# 검사(가드 a)는 이를 통과시킨다 → 가드 (g)가 경고를 에러로 승격한다.
#
# 여기 값을 두는 이유: 프로젝트 compose 를 `${VAR:-default}` 로 바꾸면 **운영
# 배포에서 빈 비밀번호가 조용히 통과**한다. 데모 값 주입은 데모 파일의 책임이다.
# 셸 env 는 compose 의 .env 파일보다 우선하므로 실 .env 를 가진 개발자도 데모
# 실행 중에는 아래 값이 적용된다 (REDIS_PASSWORD= 와 동일한 패턴).
#
# host port 를 열지 않고(expose: only) Traefik 뒤에 있으므로 리터럴 커밋이 안전하다.
PRODUCT_DB_PASSWORD=changeme-local
ORDER_DB_PASSWORD=changeme-local
PAYMENT_DB_PASSWORD=changeme-local
USER_DB_PASSWORD=changeme-local
BATCH_DB_PASSWORD=changeme-local
SHIPPING_DB_PASSWORD=changeme-local
REVIEW_DB_PASSWORD=changeme-local
PROMOTION_DB_PASSWORD=changeme-local
NOTIFICATION_DB_PASSWORD=changeme-local
# .env.example 에 선언 자체가 누락돼 있던 변수 (MONO-346 이 함께 보강)
SETTLEMENT_DB_PASSWORD=changeme-local
GRAFANA_ADMIN_PASSWORD=changeme-local
CORS_ALLOWED_ORIGINS=http://ecommerce.${DEMO_DOMAIN},http://web.ecommerce.${DEMO_DOMAIN},http://console.${DEMO_DOMAIN}
# --- 결제: mock PG 프로파일 (TASK-BE-572) --------------------------------------
# 이 블록의 이전 판은 *"데모는 결제 승인까지 가지 않으므로 더미"* 라고 적고 있었다.
# **더 이상 사실이 아니다** — 데모는 구매를 끝까지 완주한다. 승인만 가짜이고 그 뒤는 전부 진짜다.
#
# 왜 기존 `standalone` 이 아닌가: 그 프로파일도 PG 를 스텁으로 바꾸지만 **PaymentEventPublisher
# 까지 no-op** 으로 바꾼다. 결제는 완료되는데 `PaymentCompleted` 가 나가지 않아 주문 확정·배송·
# 정산 사가가 전부 멈춘다 — 화면은 "결제됨" 인데 나머지 시스템은 조용히 동의하지 않는 상태라,
# 시연 가치로 보면 결제가 아예 안 되는 것보다 나쁘다. `demo-pg` 는 **가짜인 것이 돈뿐**이다.
#
# 🔴 두 값은 **함께** 움직여야 한다. mock PG 는 아무 paymentKey 나 받아주지만 실 Toss 어댑터는
# 거부하므로, 한쪽만 켜면 체크아웃이 죽는다. 가드 (x) 가 이 쌍을 강제한다.
#
# 🔴 `prod` 를 함께 주면 payment-service 가 **부팅에 실패한다**(DemoPgProfileGuard — 의도된 것).
# ecommerce 에서 `prod` 는 실제로 아무것도 활성화하지 않으므로(실측: `@Profile("prod")` 0건 ·
# `application-prod.yml` 0건 · `on-profile` 0건) 데모가 그것을 빼도 잃는 것이 없다.
ECOMMERCE_PAYMENT_PROFILES=demo-pg
DEMO_PAYMENT_MOCK=1

# 🔴 `DEMO_PAYMENT_MOCK` 는 **팬 웹도 함께** 읽는다 (TASK-FAN-FE-015) — 한 값, 두 프런트.
# 다만 두 도메인의 **극성이 반대**라 가드도 둘로 갈린다:
#   ecommerce — 실 Toss 가 기본, `demo-pg` 프로파일을 **켜야** 목이 된다  → 가드 (x)
#   fan       — 목이 기본(`MockPaymentGatewayAdapter` 는 `@Profile("!portone")`),
#               `portone` 을 **켜야** 실 PG 가 된다                        → 가드 (x2)
# 그래서 팬의 불변식은 "프런트 플래그 ON ⟺ `portone` 프로파일 OFF" 이고, ecommerce 의
# 술어를 그대로 복사하면 **정반대를 단언**하게 된다. 팬 백엔드는 지금 목이 이미 켜져
# 있었고, 몰랐던 것은 프런트뿐이었다(그래서 구독 버튼이 눌리지 않았다).

# Toss 키는 여전히 더미로 둔다 — `demo-pg` 에서 web-store 는 Toss SDK 를 **로드조차 하지 않고**
# payment-service 는 실 어댑터를 등록하지도 않는다. 실키를 넣지 말 것.
TOSS_PAYMENTS_SECRET_KEY=test_sk_demo_not_a_real_key
NEXT_PUBLIC_TOSS_CLIENT_KEY=test_ck_demo_not_a_real_key

# --- JVM 힙 캡 (미해결) --------------------------------------------------------
# 실측(MONO-342): 힙 상한 없는 갓 기동 JVM 은 컨테이너 메모리의 1/4 까지 팽창해
# master-service 하나가 762 MiB 를 썼다. 40개 동시 기동 시 데모 호스트 사이징을
# 좌우한다.
#
# 그런데 여기서 캡을 걸 수 없다: 각 프로젝트 compose 는 byte-unchanged 로 두므로
# JAVA_TOOL_OPTIONS 를 참조하는 `${VAR}` 자리가 없다. 셸 env 는 compose 가
# 명시적으로 보간하지 않으면 컨테이너로 전달되지 않는다.
#
# 해법은 둘 중 하나이며 별도 증분이다:
#   (1) 데모 호스트를 넉넉히(32GB) 잡는다 — 현재 선택
#   (2) 각 프로젝트 compose 에 `JAVA_TOOL_OPTIONS: ${JAVA_TOOL_OPTIONS:-}` 를 추가
#       (byte-unchanged 포기, 8개 파일 수정)
