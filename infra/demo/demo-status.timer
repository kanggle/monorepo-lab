# =============================================================================
# infra/demo/demo-status.timer — 30초마다 헬스 스냅샷 발행 (TASK-MONO-477)
# =============================================================================
# AMI 빌드가 이 파일을 **저장소에서** 설치하고 enable 한다.
#
# 🔴 AccuracySec 이 장식이 아니다.
# -----------------------------------------------------------------------------
# systemd 의 기본 AccuracySec 은 **1분**이다. 즉 `OnUnitActiveSec=30s` 만 적으면
# 커널이 타이머를 최대 1분까지 뭉쳐서 깨우고, 실제 주기는 30초가 아니라 ~1분이
# 된다. 유닛은 "30초" 라고 적혀 있고 실제로는 아니다 — 티켓이 페이지에 "표시
# 지연을 정직하게" 적으라고 요구하는데, 그 정직성의 근거가 여기서 무너진다.
# 명시적으로 좁힌다.
#
# OnBootSec=60 인 이유: 부팅 직후에는 docker 도 스택도 아직 없다. 60초 전에
# 발행해 봐야 "전부 down" 인데, 그건 사실이긴 해도 웜업 중 페이지가 굳이 볼
# 필요 없는 상태다(demo-stack.service 는 TimeoutStartSec=1200 으로 돈다).
# =============================================================================
[Unit]
Description=Publish demo health snapshot every 30s (TASK-MONO-477)

[Timer]
OnBootSec=60
OnUnitActiveSec=30s
AccuracySec=5s
Unit=demo-status.service

[Install]
WantedBy=timers.target
