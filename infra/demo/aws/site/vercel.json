{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "**": false,
      "main": true,
      "preview/*": true
    }
  },
  "framework": null,
  "installCommand": "echo '[site] no dependencies - install skipped'",
  "buildCommand": "bash ./build.sh",
  "ignoreCommand": "bash \"$(git rev-parse --show-toplevel)/scripts/vercel-should-build.sh\" ':/infra/demo/aws/site' ':/scripts/vercel-should-build.sh'",
  "outputDirectory": "public",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/config.js",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=60" }]
    }
  ]
}
