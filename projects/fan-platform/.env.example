# fan-platform — local dev environment overrides
#
# Copy this file to .env to customize. .env is gitignored.
# Default values are baked into projects/fan-platform/docker-compose.yml.
# Hostname routing per ADR-MONO-001 Option C — no PORT_PREFIX needed.

# Hostname (must be present in /etc/hosts → 127.0.0.1)
PROJECT_HOSTNAME=fan-platform.local

# GAP OIDC integration
# GAP exposes itself at http://iam.local/ via the shared Traefik stack
# (TASK-MONO-024 migrated GAP to hostname routing). Start GAP with
# `pnpm iam:up` and the shared Traefik stack with `pnpm traefik:up`.
OIDC_ISSUER_URL=http://iam.local
JWT_JWKS_URI=http://iam.local/oauth2/jwks

# OIDC client credentials (fan-platform-user-flow-client, registered in GAP V0011)
# OIDC_CLIENT_ID is fixed — must match the client_id seeded in V0011.
# OIDC_CLIENT_SECRET is the dev plaintext password whose BCrypt hash is stored
# in V0011. NEVER commit the production secret here — rotate via secrets manager.
# WARNING: "fan-platform-dev" is a dev-only credential for local/portfolio use.
#          Production deployments must replace this with a strong, randomly
#          generated secret and rotate via admin API / vault.
OIDC_CLIENT_ID=fan-platform-user-flow-client
OIDC_CLIENT_SECRET=fan-platform-dev

# Spring profile (default | standalone | prod)
SPRING_PROFILES_ACTIVE=default

# Postgres — internal to fan-platform-net, no host port published.
# Per-service databases are auto-created by infra/postgres/init/01-create-databases.sh.
POSTGRES_USER=fanplatform
POSTGRES_PASSWORD=fanplatform
POSTGRES_DB=fanplatform
POSTGRES_DB_COMMUNITY=fanplatform_community
POSTGRES_DB_ARTIST=fanplatform_artist

# Redis — internal to fan-platform-net, no host port published.
# Leave blank for dev; set for staging/prod and ensure REDIS_PASSWORD reaches
# all services (gateway + community) via their service environment.
REDIS_PASSWORD=

# Kafka — community-service outbox relay target. Internal-only.
KAFKA_BOOTSTRAP=kafka:9092

# CORS allowed origins (comma-separated). The gateway echoes these to
# preflight responses; production must use real frontend hostnames only.
CORS_ALLOWED_ORIGINS=http://fan-platform.local,http://localhost:3000

# -----------------------------------------------------------------------------
# fan-platform-web (Next.js frontend) — TASK-FAN-FE-001.
# These are read by `pnpm fan-platform:web` (next dev) and the
# Next.js build for fan-platform/web/fan-platform-web/.
# -----------------------------------------------------------------------------

# Public gateway URL — baked into the browser bundle at build time.
NEXT_PUBLIC_GATEWAY_URL=http://fan-platform.local

# Server-side gateway URL (defaults to NEXT_PUBLIC_GATEWAY_URL when unset).
# Useful when running the frontend outside Docker and pointing at a different
# in-cluster hostname for SSR fetches.
GATEWAY_URL_INTERNAL=http://fan-platform.local

# next-auth v5
# NEXTAUTH_SECRET must be 32+ random bytes. `openssl rand -base64 32` is fine.
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-32-bytes-of-random-data

# GAP OIDC client - the declarations in the 'OIDC client credentials'
# section above are the ones that apply. DO NOT redeclare them here.
#
# dotenv 는 마지막 선언이 이긴다. 여기서 다시 선언하면 위쪽의 옳은 값이 아무
# 효력도 갖지 못한다. 실제로 그렇게 죽었다 - 이 자리에
# `replace-with-secret-from-iam-seed` 가 있어서 데모 호스트의 런타임 자격이
# 자리표시자가 됐고(provision-demo-env.sh 가 이 파일을 .env 로 복사한다),
# 토큰 요청이 invalid_client 401 로 떨어졌다. 브라우저에는
# `?error=Configuration` 만 보여 어느 env 가 틀렸는지 말해 주지 않았다.
# (TASK-MONO-610 기동 창 V1 -> TASK-MONO-615 B2. 가드 (z22)/(z23) 이 재발을 문다.)
#
# 위 주석의 FOLLOW-UP 은 이미 완료됐다: V0011 이 fan-platform-user-flow-client
# 를 시드하고, 그 BCrypt 해시는 평문 "fan-platform-dev" 와 맞는다.
